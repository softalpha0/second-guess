# Your Presage SmartSpectra API key (get it at https://physiology.presagetech.com/).
# Copy this file to .env and paste the key after the = sign. Never commit .env.
SMARTSPECTRA_API_KEY=

# Optional: only if the SDK runtime can't load from a folder whose path has
# non-ASCII characters. Copy node_modules/@smartspectra/node-sdk-win32-x64 to an
# ASCII-only folder and point this at smartspectra_capi.dll inside it.
# SMARTSPECTRA_CAPI_PATH=C:\smartspectra\smartspectra_capi.dll
